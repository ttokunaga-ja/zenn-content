#!/bin/sh
set -eu

# Validate locally; cross-repository publication belongs to GitHub Actions.
if [ "$(git branch --show-current)" != "main" ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
node "$repo_root/scripts/check-zenn-markdown.mjs"
exec node --test "$repo_root"/tests/*.test.mjs
